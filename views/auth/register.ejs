```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Become a Realtor | Vendor Property System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">

    <header class="auth-header">
        <a href="/" class="auth-brand">Vendor<span>Property</span></a>
        <a href="/" class="back-home">Back to Home</a>
    </header>

    <main class="auth-container">
        <section class="auth-intro">
            <p class="auth-eyebrow">JOIN OUR PLATFORM</p>
            <h1>Showcase properties. Connect with clients.</h1>
            <p>Create your realtor account and start listing properties for sale.</p>
        </section>

        <section class="auth-card">
            <h2>Create Account</h2>
            <p class="auth-subtitle">Fill in your details to get started.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="auth-error"><%= error %></div>
            <% } %>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username"
                           placeholder="Choose a username" required>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email"
                           placeholder="Enter your email" required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password"
                           placeholder="Create a password" required>
                </div>

                <button type="submit" class="auth-button">Create Account</button>
            </form>

            <p class="auth-switch">
                Already registered? <a href="/login">Sign in</a>
            </p>
        </section>
    </main>

    <footer class="auth-footer">
        &copy; <%= new Date().getFullYear() %> Vendor Property System.
        All rights reserved.
    </footer>

</body>
</html>
```