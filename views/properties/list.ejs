
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Properties | Vendor Property System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">

    <header class="auth-header">
        <a href="/" class="auth-brand">Vendor<span>Property</span></a>
        <a href="/dashboard" class="back-home">Dashboard</a>
    </header>

    <main class="properties-container">
        <div class="properties-heading">
            <div>
                <p class="auth-eyebrow">YOUR LISTINGS</p>
                <h1>My Properties</h1>
                <p class="auth-subtitle">Manage the properties you have listed for sale.</p>
            </div>
            <a href="/properties/add" class="properties-add">+ Add Property</a>
        </div>

        <% if (properties.length === 0) { %>
            <section class="auth-card empty-properties">
                <h2>No properties yet</h2>
                <p class="auth-subtitle">Add your first property to start showcasing it to clients.</p>
                <a href="/properties/add" class="properties-add">Add Your First Property</a>
            </section>
        <% } else { %>
            <section class="properties-grid">
                <% properties.forEach(property => { %>
                    <article class="property-card">

                        <% if (property.image) { %>
                            <img src="<%= property.image %>"
                                 alt="<%= property.title %>"
                                 style="width: 100%; max-height: 230px; object-fit: cover; border-radius: 8px;">
                        <% } %>

                        <h2><%= property.title %></h2>
                        <p><%= property.description %></p>
                        <p><strong>Location:</strong> <%= property.location %></p>
                        <p class="property-price">₦<%= Number(property.price).toLocaleString() %></p>

                        <div class="property-actions">
                            <a href="/properties/edit/<%= property.id %>" class="properties-add">Edit</a>

                            <form action="/properties/delete/<%= property.id %>" method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this property?')">
                                <button type="submit" class="property-delete">Delete</button>
                            </form>
                        </div>
                    </article>
                <% }) %>
            </section>
        <% } %>

        <a href="/dashboard" class="dashboard-home">← Back to Dashboard</a>
    </main>

    <footer class="auth-footer">
        &copy; <%= new Date().getFullYear() %> Vendor Property System.
        All rights reserved.
    </footer>

</body>
</html>

